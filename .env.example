# Warmane Daily Points Collector
# Supports 1–20 accounts. Add/remove blocks as needed.
# The script stops at the first missing WARMANE_USERNAME_N / WARMANE_PASSWORD_N.
#
# The script logs in with your account credentials through a headless browser
# (needed to pass Cloudflare Turnstile on the login form), then collects points.
#
# WARMANE_NAME_N is just a label used in the logs (optional; defaults to the
# username).

# --- Account 1 ---
WARMANE_NAME_1=AccountName1
WARMANE_USERNAME_1=myusername1
WARMANE_PASSWORD_1=mypassword1

# --- Account 2 ---
WARMANE_NAME_2=AccountName2
WARMANE_USERNAME_2=myusername2
WARMANE_PASSWORD_2=mypassword2

# --- Account 3 ---
# WARMANE_NAME_3=AccountName3
# WARMANE_USERNAME_3=myusername3
# WARMANE_PASSWORD_3=mypassword3

# ... repeat up to WARMANE_NAME_20 / WARMANE_USERNAME_20 / WARMANE_PASSWORD_20

# --- Optional tuning ---
# How long (ms) to wait for Turnstile to issue its token (default: 45000).
# WARMANE_TURNSTILE_TIMEOUT=45000
# Force headless Chromium (default: false). NOT recommended — Cloudflare
# usually refuses to issue a token to a headless browser.
# WARMANE_HEADLESS=true
